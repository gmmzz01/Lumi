# Copia este archivo como ".env" y rellena tu clave.
#   cp .env.example .env

# Clave de la API de OpenAI (OBLIGATORIO)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo de voz a voz (Realtime)
OPENAI_MODEL=gpt-realtime

# Voz de la respuesta
VOICE=coral

# Dónde escucha el relay (0.0.0.0 = todas las interfaces de tu PC)
RELAY_HOST=0.0.0.0
RELAY_PORT=8765
